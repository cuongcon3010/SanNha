# Sao chép thành FE/.env.local rồi khởi động lại npm run dev.
# URL BACKEND mà trình duyệt truy cập được, không có dấu / cuối.
# Chạy local: giữ nguyên. Deploy: thay bằng HTTPS API origin công khai.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
# FRONTEND_ORIGIN trong BE/.env phải khớp origin của frontend (local: http://localhost:3000).
# NEXT_PUBLIC_* được gửi ra trình duyệt: KHÔNG đặt OAuth secret, mật khẩu DB
# hoặc credentials VietQR ở đây. Các thông tin đó chỉ nằm trong BE/.env.
