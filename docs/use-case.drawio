        <mxCell id="title" value="SÂN NHÀ · SƠ ĐỒ USE CASE" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#111210;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="880" height="50" as="geometry"/></mxCell>
        <mxCell id="system" value="HỆ THỐNG ĐẶT VÀ QUẢN LÝ SÂN THỂ THAO" style="swimlane;html=1;startSize=45;fillColor=#F6F5EF;swimlaneFillColor=#FFFFFF;strokeColor=#111210;fontColor=#111210;fontStyle=1;fontSize=15;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="920" height="1320" as="geometry"/></mxCell>
