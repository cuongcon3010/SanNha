        <mxCell id="google" value="Google" style="shape=umlActor;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#111210;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1390" y="280" width="50" height="85" as="geometry"/></mxCell>
        <mxCell id="github" value="GitHub" style="shape=umlActor;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#111210;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1500" y="280" width="50" height="85" as="geometry"/></mxCell>
        <mxCell id="browse" value="Tìm kiếm và xem thông tin sân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="80" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="availability" value="Xem khung giờ trống" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="180" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="register" value="Đăng ký người chơi / chủ sân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="280" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="password" value="Đăng nhập bằng mật khẩu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="350" y="80" width="240" height="65" as="geometry"/></mxCell>
