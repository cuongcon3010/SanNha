        <mxCell id="profile" value="Xem / cập nhật hồ sơ và đăng xuất" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="440" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="favorite" value="Lưu / bỏ sân yêu thích" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="540" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="book" value="Đặt sân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5D547;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="640" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="validate" value="Kiểm tra sân và khung giờ hợp lệ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#797B72;fontSize=13;" vertex="1" parent="system"><mxGeometry x="350" y="640" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="mybookings" value="Xem / hủy lịch đặt của mình" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="740" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="venue" value="Đăng ký cơ sở sân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="650" y="440" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="rates" value="Cập nhật giá và bảo trì sân con" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="650" y="540" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="schedule" value="Xem / xác nhận / hoàn thành / hủy lịch sân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="650" y="640" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="block" value="Khóa / mở khóa khung giờ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="650" y="740" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="revenue" value="Xem giá trị lịch theo tháng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2BB;strokeColor=#111210;fontSize=13;" vertex="1" parent="system"><mxGeometry x="650" y="840" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="users" value="Xem / khóa / mở khóa người dùng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCE9E5;strokeColor=#E84938;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="990" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="review" value="Duyệt / từ chối hồ sơ sân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCE9E5;strokeColor=#E84938;fontSize=13;" vertex="1" parent="system"><mxGeometry x="40" y="1100" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="adminnote" value="Admin cũng có quyền quản lý trạng thái lịch và xem báo cáo theo sân qua API. Không có đăng ký admin công khai." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F6F5EF;strokeColor=#797B72;fontSize=12;align=left;spacing=12;" vertex="1" parent="system"><mxGeometry x="350" y="1100" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="authnote" value="Tiền điều kiện: các chức năng cá nhân/quản lý yêu cầu đăng nhập. Chủ sân chỉ quản lý sân của mình. OAuth tạo tài khoản người chơi; không tự ghép email." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F6F5EF;strokeColor=#797B72;fontSize=12;align=left;spacing=12;" vertex="1" parent="system"><mxGeometry x="350" y="280" width="540" height="110" as="geometry"/></mxCell>
        <mxCell id="legend" value="PHẠM VI: chức năng backend/API hiện có. FE đặt sân và dashboard vẫn là demo; OAuth và /tai-khoan dùng phiên thật. Không bao gồm thanh toán, OTP, gửi email hoặc ghép tài khoản OAuth. Đường liền: tương tác; mũi tên nét đứt «include»: hành vi bắt buộc được dùng lại. Người chơi cũng có thể tìm sân/xem lịch trống như Khách." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#55584F;" vertex="1" parent="1"><mxGeometry x="340" y="1450" width="920" height="90" as="geometry"/></mxCell>
        <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#797B72;" edge="1" source="guest" target="browse" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e02" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#797B72;" edge="1" source="guest" target="availability" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
