<mxfile host="app.diagrams.net" type="device">
  <diagram id="register" name="01 - Đăng ký">
    <mxGraphModel grid="1" page="1" pageWidth="1169" pageHeight="827"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="note" value="Đăng ký qua API backend; form mật khẩu FE hiện vẫn là demo. Nhánh lỗi trả về ngay, không tiếp tục tạo tài khoản." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="980" height="45" as="geometry"/></mxCell>
      <mxCell id="u" value="Người dùng" style="shape=umlLifeline;perimeter=lifelinePerimeter;participant=umlActor;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="70" width="100" height="650" as="geometry"/></mxCell>
      <mxCell id="c" value="Client" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="120" height="650" as="geometry"/></mxCell>
      <mxCell id="i" value="Identity" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="120" height="650" as="geometry"/></mxCell>
      <mxCell id="d" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="890" y="70" width="120" height="650" as="geometry"/></mxCell>
      <mxCell id="m1" value="1. Nhập thông tin đăng ký" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="170" as="sourcePoint"/><mxPoint x="390" y="170" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m2" value="2. POST /api/v1/auth/register" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="230" as="sourcePoint"/><mxPoint x="670" y="230" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n1" value="Kiểm tra dữ liệu và vai trò; dữ liệu sai → 400. Băm mật khẩu PBKDF2 trước khi lưu." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="690" y="260" width="240" height="70" as="geometry"/></mxCell>
      <mxCell id="m3" value="3. Tạo user, email duy nhất" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="370" as="sourcePoint"/><mxPoint x="950" y="370" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m4" value="4. Tài khoản mới / lỗi email trùng" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="440" as="sourcePoint"/><mxPoint x="670" y="440" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m5" value="5. Thành công: 201 / email trùng: 409" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="520" as="sourcePoint"/><mxPoint x="390" y="520" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m6" value="6. Hiển thị kết quả; đăng ký không tự đăng nhập" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="610" as="sourcePoint"/><mxPoint x="120" y="610" as="targetPoint"/></mxGeometry></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="login" name="02 - Đăng nhập mật khẩu">
    <mxGraphModel grid="1" page="1" pageWidth="1169" pageHeight="827"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="note" value="Đăng nhập API backend. Thông tin sai hoặc tài khoản bị khóa: từ chối, không tạo phiên." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="980" height="45" as="geometry"/></mxCell>
      <mxCell id="u" value="Người dùng" style="shape=umlLifeline;perimeter=lifelinePerimeter;participant=umlActor;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="70" width="100" height="650" as="geometry"/></mxCell>
      <mxCell id="c" value="Client" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="120" height="650" as="geometry"/></mxCell>
      <mxCell id="i" value="Identity" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="120" height="650" as="geometry"/></mxCell>
      <mxCell id="d" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="890" y="70" width="120" height="650" as="geometry"/></mxCell>
      <mxCell id="m1" value="1. Nhập email và mật khẩu" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="160" as="sourcePoint"/><mxPoint x="390" y="160" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m2" value="2. POST /api/v1/auth/login" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="220" as="sourcePoint"/><mxPoint x="670" y="220" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m3" value="3. Tìm tài khoản theo email" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="280" as="sourcePoint"/><mxPoint x="950" y="280" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m4" value="4. Thông tin tài khoản" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="340" as="sourcePoint"/><mxPoint x="670" y="340" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n1" value="Kiểm tra mật khẩu và khóa tài khoản. Hợp lệ: sinh token phiên ngẫu nhiên." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="690" y="365" width="240" height="65" as="geometry"/></mxCell>
      <mxCell id="m5" value="5. Kiểm tra lại khóa và lưu hash token phiên" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="470" as="sourcePoint"/><mxPoint x="950" y="470" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m6" value="6. Lưu thành công" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="520" as="sourcePoint"/><mxPoint x="670" y="520" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m7" value="7. 200 + cookie HttpOnly sannha_session" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="590" as="sourcePoint"/><mxPoint x="390" y="590" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m8" value="8. Hiển thị đăng nhập thành công" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="650" as="sourcePoint"/><mxPoint x="120" y="650" as="targetPoint"/></mxGeometry></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="booking" name="03 - Đặt sân có voucher">
    <mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1100"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="note" value="Luồng đặt sân thật. Các request được Identity xác thực bằng cookie trước khi vào Booking. Báo giá không giữ slot hoặc quota." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1240" height="45" as="geometry"/></mxCell>
      <mxCell id="u" value="Người chơi" style="shape=umlLifeline;perimeter=lifelinePerimeter;participant=umlActor;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="100" height="930" as="geometry"/></mxCell>
      <mxCell id="f" value="Frontend" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="120" height="930" as="geometry"/></mxCell>
      <mxCell id="b" value="Booking" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="120" height="930" as="geometry"/></mxCell>
      <mxCell id="v" value="Venue / Catalog" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="140" height="930" as="geometry"/></mxCell>
      <mxCell id="d" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="1150" y="70" width="120" height="930" as="geometry"/></mxCell>
      <mxCell id="m1" value="1. Chọn sân, giờ và voucher" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="155" as="sourcePoint"/><mxPoint x="350" y="155" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m2" value="2. POST /bookings/quote" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="210" as="sourcePoint"/><mxPoint x="630" y="210" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m3" value="3. Lấy thông tin và giá sân" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="260" as="sourcePoint"/><mxPoint x="920" y="260" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m4" value="4. Giá, trạng thái và bảo trì" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="310" as="sourcePoint"/><mxPoint x="630" y="310" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m5" value="5. Kiểm tra slot, thời hạn và lượt voucher" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="360" as="sourcePoint"/><mxPoint x="1210" y="360" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m6" value="6. Kết quả kiểm tra" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="405" as="sourcePoint"/><mxPoint x="630" y="405" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m7" value="7. Giá gốc, giảm giá, tổng và cọc" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="455" as="sourcePoint"/><mxPoint x="350" y="455" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m8" value="8. Xác nhận đặt sân" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="510" as="sourcePoint"/><mxPoint x="350" y="510" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m9" value="9. POST /bookings với voucherCode" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="560" as="sourcePoint"/><mxPoint x="630" y="560" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m10" value="10. Lấy lại thông tin và giá hiện tại" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="610" as="sourcePoint"/><mxPoint x="920" y="610" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m11" value="11. Thông tin sân hiện tại" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="655" as="sourcePoint"/><mxPoint x="630" y="655" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m12" value="12. BEGIN; khóa voucher; kiểm tra lại điều kiện" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="705" as="sourcePoint"/><mxPoint x="1210" y="705" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m13" value="13. Tạo booking snapshot giá; giữ lượt; COMMIT" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="765" as="sourcePoint"/><mxPoint x="1210" y="765" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n1" value="Nếu voucher không hợp lệ hoặc slot bị trùng: ROLLBACK toàn bộ, trả lỗi; không giữ lượt và không âm thầm bỏ mã." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="850" y="800" width="330" height="65" as="geometry"/></mxCell>
      <mxCell id="m14" value="14. 201 - Booking và cọc sau giảm" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="895" as="sourcePoint"/><mxPoint x="350" y="895" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m15" value="15. Chuyển sang trang thanh toán" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="950" as="sourcePoint"/><mxPoint x="100" y="950" as="targetPoint"/></mxGeometry></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="payment" name="04 - Thanh toán VietQR">
    <mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1400"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="note" value="Chỉ callback đã xác thực mới là bằng chứng thanh toán. Demo dùng Test Callback sandbox, không chuyển tiền thật. Prefix API: /api/v1." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1240" height="45" as="geometry"/></mxCell>
      <mxCell id="u" value="Người chơi" style="shape=umlLifeline;perimeter=lifelinePerimeter;participant=umlActor;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="100" height="1210" as="geometry"/></mxCell>
      <mxCell id="f" value="Frontend" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="120" height="1210" as="geometry"/></mxCell>
      <mxCell id="b" value="Booking / Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="140" height="1210" as="geometry"/></mxCell>
      <mxCell id="d" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="70" width="120" height="1210" as="geometry"/></mxCell>
      <mxCell id="q" value="VietQR / Tingo Pay" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="1140" y="70" width="150" height="1210" as="geometry"/></mxCell>
      <mxCell id="m1" value="1. Bấm tạo QR" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="155" as="sourcePoint"/><mxPoint x="350" y="155" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m2" value="2. POST /bookings/{id}/payment" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="210" as="sourcePoint"/><mxPoint x="640" y="210" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n1" value="Xác thực phiên, chủ sở hữu, trạng thái pending và thời gian lịch." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="660" y="230" width="230" height="60" as="geometry"/></mxCell>
      <mxCell id="m3" value="3. Khóa booking; lưu đơn với cọc snapshot; COMMIT" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="330" as="sourcePoint"/><mxPoint x="920" y="330" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m4" value="4. Lấy token và yêu cầu QR cùng mã đơn ổn định" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="390" as="sourcePoint"/><mxPoint x="1215" y="390" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m5" value="5. QR và thông tin nhận tiền" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="440" as="sourcePoint"/><mxPoint x="640" y="440" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m6" value="6. Kiểm tra receiver, tiền, mã đơn; lưu QR" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="495" as="sourcePoint"/><mxPoint x="920" y="495" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m7" value="7. Trả QR và số tiền cọc" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="550" as="sourcePoint"/><mxPoint x="350" y="550" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m8" value="8. Hiển thị QR" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="600" as="sourcePoint"/><mxPoint x="100" y="600" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m9" value="9. Thanh toán hoặc kích hoạt Test Callback sandbox" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="660" as="sourcePoint"/><mxPoint x="1215" y="660" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m10" value="10. POST token_generate với Basic Auth callback" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="720" as="sourcePoint"/><mxPoint x="640" y="720" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m11" value="11. Xác thực; lưu hash token callback có hạn" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="770" as="sourcePoint"/><mxPoint x="920" y="770" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m12" value="12. Bearer token callback" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="820" as="sourcePoint"/><mxPoint x="1215" y="820" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m13" value="13. POST transaction-sync với Bearer token" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="870" as="sourcePoint"/><mxPoint x="640" y="870" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n2" value="Kiểm tra token, tiền, tài khoản, thời gian, trạng thái và giao dịch trùng. Đúng: xác nhận cọc. Sai/lịch hủy: đối soát. Trùng khớp: không ghi nhận lần hai." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="950" y="900" width="330" height="90" as="geometry"/></mxCell>
      <mxCell id="m14" value="14. Transaction: lưu event + trạng thái booking/payment; COMMIT" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1020" as="sourcePoint"/><mxPoint x="920" y="1020" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m15" value="15. ACK sau commit; lỗi DB trả lỗi để retry" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1070" as="sourcePoint"/><mxPoint x="1215" y="1070" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m16" value="16. GET payment mỗi 5 giây khi còn chờ, chưa hết hạn" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1120" as="sourcePoint"/><mxPoint x="640" y="1120" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m17" value="17. Đọc trạng thái đã lưu trong PostgreSQL" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1160" as="sourcePoint"/><mxPoint x="920" y="1160" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m18" value="18. Trả trạng thái đã lưu" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="1200" as="sourcePoint"/><mxPoint x="640" y="1200" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m19" value="19. pending / paid / review" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1250" as="sourcePoint"/><mxPoint x="350" y="1250" as="targetPoint"/></mxGeometry></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="oauth" name="05 - OAuth Google GitHub">
    <mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1500"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="note" value="OAuth dùng cho cả đăng ký lần đầu và đăng nhập. Không tự ghép tài khoản theo email; không gửi provider token ra frontend. Nhánh lỗi dừng luồng." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1240" height="45" as="geometry"/></mxCell>
      <mxCell id="u" value="Người dùng / Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;participant=umlActor;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="150" height="1330" as="geometry"/></mxCell>
      <mxCell id="f" value="Frontend" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="120" height="1330" as="geometry"/></mxCell>
      <mxCell id="i" value="Backend Identity" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="140" height="1330" as="geometry"/></mxCell>
      <mxCell id="d" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="880" y="70" width="120" height="1330" as="geometry"/></mxCell>
      <mxCell id="p" value="Google / GitHub" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="140" height="1330" as="geometry"/></mxCell>
      <mxCell id="m1" value="1. Chọn Google hoặc GitHub" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="155" as="sourcePoint"/><mxPoint x="360" y="155" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m2" value="2. Điều hướng GET /auth/oauth/{provider}/start" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="215" as="sourcePoint"/><mxPoint x="650" y="215" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m3" value="3. Lưu hash state/browser và PKCE; hạn 10 phút" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="275" as="sourcePoint"/><mxPoint x="940" y="275" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m4" value="4. Cookie HttpOnly và redirect tới provider" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="335" as="sourcePoint"/><mxPoint x="125" y="335" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m5" value="5. Đăng nhập và cấp quyền" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="395" as="sourcePoint"/><mxPoint x="1230" y="395" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m6" value="6. Redirect callback qua browser: code + state" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="455" as="sourcePoint"/><mxPoint x="125" y="455" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m7" value="7. GET /auth/oauth/{provider}/callback + cookie" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="515" as="sourcePoint"/><mxPoint x="650" y="515" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m8" value="8. Kiểm tra và tiêu thụ state một lần" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="575" as="sourcePoint"/><mxPoint x="940" y="575" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n1" value="Sai state, cookie, provider hoặc hết hạn: từ chối. Người dùng từ chối cấp quyền: chuyển về FE với mã lỗi." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="950" y="600" width="310" height="70" as="geometry"/></mxCell>
      <mxCell id="m9" value="9. Đổi code lấy token với PKCE verifier" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="710" as="sourcePoint"/><mxPoint x="1230" y="710" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m10" value="10. Access token chỉ dùng server-side" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="765" as="sourcePoint"/><mxPoint x="650" y="765" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m11" value="11. Lấy danh tính và email đã xác minh" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="820" as="sourcePoint"/><mxPoint x="1230" y="820" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m12" value="12. Provider subject và hồ sơ; GitHub có thể gọi thêm API email" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="875" as="sourcePoint"/><mxPoint x="650" y="875" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m13" value="13. Tìm tài khoản theo provider + subject" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="930" as="sourcePoint"/><mxPoint x="940" y="930" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n2" value="Đã liên kết: dùng user hiện có. Chưa có: tạo user role user và liên kết trong transaction. Email thuộc tài khoản khác: account_exists, không tự ghép. User bị khóa: từ chối." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="970" y="960" width="310" height="110" as="geometry"/></mxCell>
      <mxCell id="m14" value="14. Khi hợp lệ: lưu phiên với hash token" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="1110" as="sourcePoint"/><mxPoint x="940" y="1110" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m15" value="15. Cookie sannha_session và redirect /tai-khoan" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="1170" as="sourcePoint"/><mxPoint x="125" y="1170" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m16" value="16. Mở trang /tai-khoan" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="1220" as="sourcePoint"/><mxPoint x="360" y="1220" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m17" value="17. GET /api/v1/me kèm cookie" style="endArrow=block;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1270" as="sourcePoint"/><mxPoint x="650" y="1270" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m18" value="18. Thông tin người dùng đã xác thực" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="1320" as="sourcePoint"/><mxPoint x="360" y="1320" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="m19" value="19. Hiển thị tài khoản" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1370" as="sourcePoint"/><mxPoint x="125" y="1370" as="targetPoint"/></mxGeometry></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
