# MẪU DEMO LOCAL — sao chép thành BE/.env, không commit credentials thật.
# Chạy trong BE/ sau khi chỉnh sửa (Go không tự đọc .env):
#   set -a
#   . ./.env
#   set +a
#   go run ./cmd/api
# Giữ dấu nháy cho giá trị có khoảng trắng/ký tự đặc biệt.

# ── 1. Server & frontend ──────────────────────────────────────────────
HTTP_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:3000
# Local HTTP: false. Khi triển khai HTTPS: true; FE/API cần cùng site.
COOKIE_SECURE=false

# ── 2. PostgreSQL ─────────────────────────────────────────────────────
# Docker Compose dùng 3 biến POSTGRES_* để tạo database lần đầu.
POSTGRES_USER=sannha
POSTGRES_DB=sannha
POSTGRES_PASSWORD='CHANGE_ME'
# Thay CHANGE_ME giống POSTGRES_PASSWORD ở trên; Go dùng URL này để kết nối.
# URL-encode ký tự đặc biệt trong mật khẩu (vd @ → %40); sslmode=disable chỉ cho local.
DATABASE_URL='postgres://sannha:CHANGE_ME@localhost:5432/sannha?sslmode=disable'
# Đổi mật khẩu ở đây KHÔNG đổi mật khẩu của database/volume đã tồn tại.
# Test cần database riêng đã tạo, ví dụ sannha_test. KHÔNG dùng DB chứa dữ liệu thật.
# TEST_DATABASE_URL='postgres://sannha:CHANGE_ME@localhost:5432/sannha_test?sslmode=disable'
TEST_DATABASE_URL=''

# ── 3. Tạo admin (chỉ dùng bởi go run ./cmd/admin) ─────────────────────
# Tự điền email/mật khẩu riêng khi cần tạo admin; không có admin mặc định.
ADMIN_EMAIL=''
ADMIN_PASSWORD=''

# ── 4. OAuth Google / GitHub ──────────────────────────────────────────
# Origin của BACKEND, không phải frontend; không có dấu / cuối.
OAUTH_API_ORIGIN=http://localhost:8080
# Mỗi provider: điền CẢ ID và SECRET để bật; để trống CẢ HAI để tắt.
# Google Cloud Console → OAuth Client → Web application.
# Redirect URI: http://localhost:8080/api/v1/auth/oauth/google/callback
# Consent screen đang Testing: thêm email demo vào Test users.
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
# GitHub Settings → Developer settings → OAuth Apps.
# Homepage: http://localhost:3000
# Callback: http://localhost:8080/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''
# Đổi OAUTH_API_ORIGIN khi deploy thì phải đổi callback trong console tương ứng.
# Xem OAUTH.md. Không đưa secret vào FE hoặc NEXT_PUBLIC_*.

# ── 5. VietQR / Tingo Pay (demo SANDBOX, không chuyển tiền thật) ────────
# Đăng ký merchant: https://vietqr.vn/merchant/request
# Xin credentials sandbox và thông tin ngân hàng được VietQR cấp/xác nhận.
# Chỉ đổi thành true sau khi điền đủ các biến bên dưới.
VIETQR_ENABLED=false
VIETQR_ENV=sandbox
# VietQR CẤP: dùng để backend gọi API tạo QR, không phải tài khoản đăng nhập app.
VIETQR_USERNAME=''
VIETQR_PASSWORD=''
# BẠN TỰ TẠO và đăng ký với VietQR: credentials riêng để bảo vệ callback.
# Tạo password ngẫu nhiên: openssl rand -hex 32 (ít nhất 32 byte).
VIETQR_CALLBACK_USERNAME=''
VIETQR_CALLBACK_PASSWORD=''
# Ngân hàng merchant/sandbox đã liên kết; mã ngân hàng ví dụ MB/BIDV.
VIETQR_BANK_CODE=''
VIETQR_BANK_ACCOUNT=''
# Tên CHỦ TÀI KHOẢN viết IN HOA, không dấu; không phải tên ngân hàng.
VIETQR_BANK_NAME=''
# Đăng ký 2 callback HTTPS công khai với VietQR (local cần tunnel đến :8080):
# POST https://<domain-api>/api/v1/payments/vietqr/api/token_generate
# POST https://<domain-api>/api/v1/payments/vietqr/bank/api/transaction-sync
# <domain-api> chỉ là chỗ thay thế trong hướng dẫn, không phải biến môi trường.
# Xem VIETQR.md; dùng Test Callback sandbox để kiểm tra tự xác nhận cọc.
# Không đổi sang production chỉ để demo; chưa có hoàn tiền tự động.
